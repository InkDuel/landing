# Firebase web config. Public by design (it ships to every browser); the
# security comes from Auth, the backend and the key's domain restriction.
# Set the real values in Vercel (Production and Preview) and in .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inkduel-4540e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inkduel-4540e
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Backend base URL for the signed-in area. Defaults to production.
# For local QA against a local backend (ENV=development allows
# http://localhost:3000): http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=
